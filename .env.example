# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads

# LLM providers (added in Week 1+)
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Answering
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_THINK=false        # for Qwen3-style models: skip the slow reasoning phase
# MIN_VECTOR_SCORE=0.48     # "I don't know" threshold; calibrate with python -m evals.threshold_eval
# ANSWER_TOP_K=5
# LLM_TIMEOUT_S=120
# DB_CONNECT_TIMEOUT_S=5   # how long to wait for the database before failing

# --- Which LLM answers (all optional) ---
# Leave every key empty to run fully local on Ollama. The app uses the first available provider in this order:
# OpenAI -> Gemini -> OpenRouter -> local Ollama (always the last fallback).
# Keys go in your private .env (git-ignored), never in this file.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# LLM_PROVIDERS=auto
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
